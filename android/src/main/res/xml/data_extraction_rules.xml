<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone.

  `android:allowBackup="false"` already stops the cloud backup, but from Android
  12 that attribute no longer governs device-to-device transfer. Without this
  file, moving to a new phone would copy the ledger across — which may well be
  what somebody wants, and is not what the profile screen promises.

  The screen says the ledger is kept on this phone only and that nothing is sent
  anywhere. Until there is a sync somebody has agreed to, that has to be true of
  every route off the device, not only the one Android used to call backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
